# ── Agate-Liara configuration ───────────────────────────────────────────────
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored. NEVER commit a real token.

# REQUIRED — Liara API token (console.liara.ir → API → create token)
LIARA_API_TOKEN=

# OPTIONAL — Liara team id. When set, `?teamID=<id>` is appended to every request.
LIARA_TEAM_ID=

# OPTIONAL — API base URLs (defaults shown)
LIARA_API_BASE=https://api.iran.liara.ir
LIARA_DNS_BASE=https://dns-service.iran.liara.ir

# OPTIONAL — comma separated allow-list of apps that write tools may touch
AGATE_ALLOWED_APPS=agate-liara

# OPTIONAL — OpenAI-compatible chat endpoint for LLM-assisted ranking.
# Leave empty to run in "rules only" mode (fully functional without an LLM).
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# OPTIONAL — diagnose loop: agentic (default when LLM_* is set) | fixed
# fixed keeps the current collect-then-rank path. agentic may only call read-only tools.
INVESTIGATE_MODE=

# OPTIONAL — demo-site admin key used by /__agate-admin?key=...
ADMIN_KEY=
# OPTIONAL — initial bug mode for the demo site: off | leak | slow | error500
BUG_MODE=off

# OPTIONAL — write approval policy: strict (default) | balanced | auto
# High-risk/costly actions always require approval in every policy.
APPROVAL_POLICY=strict

# OPTIONAL — continuous watcher (npm run watch)
# App defaults to the first AGATE_ALLOWED_APPS entry.
WATCH_APP=agate-liara
# Probe interval in seconds (minimum 10).
WATCH_INTERVAL_SEC=60
# Suppress duplicate incidents for this many seconds after an alert.
WATCH_COOLDOWN_SEC=300
# Allow policy-aware remediation after diagnosis; strict still asks for approval.
WATCH_REMEDIATE=true
