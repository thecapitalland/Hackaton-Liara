{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IncidentReport",
  "type": "object",
  "required": ["incidentId","appId","observedAt","status","evidence","hypotheses","limitations"],
  "properties": {
    "incidentId": {"type":"string"}, "appId":{"type":"string"}, "observedAt":{"type":"string","format":"date-time"},
    "status":{"enum":["investigating","diagnosed","awaiting_approval","remediating","verified","failed","inconclusive"]},
    "evidence":{"type":"array","items":{"type":"object","required":["id","source","observation"],"properties":{"id":{"type":"string"},"source":{"enum":["logs","metrics","events","probe","env"]},"observation":{"type":"string"},"available":{"type":"boolean"}}}},
    "hypotheses":{"type":"array","maxItems":3,"items":{"type":"object","required":["rank","cause","confidence","evidenceIds","kind","remedies"],"properties":{"rank":{"type":"integer","minimum":1,"maximum":3},"cause":{"type":"string"},"confidence":{"type":"number","minimum":0,"maximum":1},"evidenceIds":{"type":"array","items":{"type":"string"}},"kind":{"enum":["observed","inferred"]},"remedies":{"type":"array","items":{"enum":["restart","resize","code_fix","set_env","scale"]}}}}},
    "verification":{"type":["object","null"]}, "limitations":{"type":"array","items":{"type":"string"}}
  }
}
